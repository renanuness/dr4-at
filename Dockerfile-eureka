# --- Estágio 1: build ---
# Imagem com Maven + JDK 17, usada só para compilar. Não vai pra imagem final.
FROM maven:3-eclipse-temurin-25-alpine AS build
WORKDIR /app

# Copia só o pom.xml primeiro (sem o código-fonte ainda)
COPY ./pom.xml .
COPY api-gateway/pom.xml         api-gateway/
COPY contrato-service/pom.xml    contrato-service/
COPY notificacao-service/pom.xml notificacao-service/
COPY reputacao-service/pom.xml   reputacao-service/
COPY auditoria-service/pom.xml   auditoria-service/
COPY ./eureka-server/pom.xml     eureka-server/
# Baixa as dependências agora. Se o pom.xml não mudar, o Docker reaproveita
# essa camada em cache e pula o download nos builds seguintes.
RUN mvn -pl eureka-server -am dependency:go-offline -B

# Copy source
COPY eureka-server/src eureka-server/src

# Build only this module (and its needed parents)
RUN mvn -pl eureka-server -am package -DskipTests -B

# --- Estágio 2: runtime ---
# Imagem final, só com o JRE (bem mais leve; não carrega Maven nem código-fonte)
FROM eclipse-temurin:25-jre-alpine
WORKDIR /app

# Traz apenas o .jar gerado no estágio "build" acima
COPY --from=build /app/eureka-server/target/*.jar app.jar

# Documenta a porta usada pela aplicação (não publica sozinha; quem expõe
# de verdade pra fora do container é o "ports:" no docker-compose.yml)
EXPOSE 8761

# Comando executado quando o container sobe
ENTRYPOINT ["java", "-jar", "app.jar"]